# Plaintext example of the vault file.
# See README.md for instructions on how to create and encrypt secrets.yml.
#
# To create your encrypted vault:
#   ansible-vault create playbooks/group_vars/all/secrets.yml
#
# To edit it later:
#   ansible-vault edit playbooks/group_vars/all/secrets.yml

# The admin user of dom0
admin_user: your_dom0_username

# The Proton VPN keyring information, extract the data from ~/.local/share/keyrings/Default.keyring where the VPN is installed
proton_vpn_username: 'account@proton.me'
proton_vpn_sso_username: 'proton-sso-account-xxx'
proton_vpn_secret: ''

# Proton Mail Bridge (role proton_bridge, playbook email)
# Accounts configured in Thunderbird, one per Proton account logged into the Bridge
proton_bridge_accounts:
  - email: 'account@proton.me'
    name: 'Your Name'
# Printed by ~/.local/bin/proton-bridge-export.sh in the email AppVM once you are
# logged in to the Bridge. Leave them out on the first run: the Bridge then starts
# without accounts and you log in once in its window.
proton_bridge_vault_key: ''
proton_bridge_vault_enc_b64: ''
# Optional, printed by the same script: the Bridge password saved by Thunderbird and
# the accepted Bridge certificate, so Thunderbird asks nothing after a rebuild
proton_bridge_thunderbird_key4_db_b64: ''
proton_bridge_thunderbird_logins_json_b64: ''
proton_bridge_thunderbird_cert_override_b64: ''
